{
  "additional-repositories": ["multilib"],
  "audio_config": { "audio": "pipewire" },
  "bootloader": "grub",
  "hostname": "x1c",
  "kernels": ["linux", "linux-lts"],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "network_config": { "type": "nm" },
  "ntp": true,
  "packages": [
    "base-devel",
    "git",
    "vim",
    "intel-ucode",
    "linux-firmware",
    "btrfs-progs",
    "snapper",
    "snap-pac",
    "networkmanager",
    "openssh"
  ],
  "parallel_downloads": 5,
  "profile_config": { "profile": { "main": "Minimal" } },
  "swap": true,
  "timezone": "UTC",
  "disk_config": {
    "config_type": "default_layout",
    "btrfs_options": {
      "snapshot_config": { "type": "snapper" }
    }
  }
}
