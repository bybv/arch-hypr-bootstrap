# Per-machine overrides — copy to <hostname>.env and edit.
# Sourced by bootstrap-base.sh only if you wire it up; most setups won't need it.
#
# Example: point waybar's server-status module at your actual home server.
# HOME_SERVER=server.local
#
# Example: a real .env for an actual host would be named e.g. x1c-gen13.env
# and is gitignored by default (only this example file is tracked).
